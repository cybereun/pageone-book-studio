{
  "name": "pageone-personal-studio",
  "version": "2.0.2",
  "private": true,
  "description": "PAGEONE 개인 출판 작업실",
  "author": "Lebi",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "cfb": "1.2.2",
    "epubjs": "0.3.93",
    "fast-xml-parser": "5.3.6",
    "jszip": "3.10.1",
    "mammoth": "1.11.0",
    "pagedjs": "0.4.3",
    "pako": "2.1.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "42.0.0",
    "electron-builder": "26.0.12",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "com.pageone.studio",
    "productName": "PAGEONE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "public/pageone-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/pageone-icon.ico",
      "uninstallerIcon": "public/pageone-icon.ico"
    },
    "compression": "normal"
  }
}
